# Copy to .env and fill in real values. .env is git-ignored.
POSTGRES_PASSWORD=change-me
# Used by the diesel CLI (`diesel migration run`).
DATABASE_URL=postgres://rudrist_admin:change-me@localhost:5432/rudristdb
# Used by Rocket at runtime.
ROCKET_DATABASES={postgres_db={url="postgres://rudrist_admin:change-me@localhost:5432/rudristdb"}}
# Required in release builds. Generate with: openssl rand -base64 32
ROCKET_SECRET_KEY=
